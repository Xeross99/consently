<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= t("demo.policy_title") %></title>
    <%= csrf_meta_tags %>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script type="importmap">
      {
        "imports": {
          "@hotwired/stimulus": "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/dist/stimulus.js",
          "consently/banner_controller": "<%= asset_path("consently/banner_controller.js") %>"
        }
      }
    </script>
    <script type="module">
      import { Application } from "@hotwired/stimulus"
      import ConsentlyBannerController from "consently/banner_controller"

      window.Stimulus = Application.start()
      Stimulus.register("consently-banner", ConsentlyBannerController)
    </script>

    <%= consently_tags %>
  </head>

  <body class="bg-gray-50">
    <%= consently_noscript_tags %>

    <main class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-sm"><%= link_to t("demo.policy_back"), demo_path(locale: params[:locale]), class: "text-gray-500 underline" %></p>

      <h1 class="mt-4 text-3xl font-semibold text-gray-900"><%= t("demo.policy_title") %></h1>
      <p class="mt-3 text-gray-600"><%= t("demo.policy_intro") %></p>

      <%# The page's own heading and legal text are the application's; the
          table of categories, vendors and cookies comes from the gem. %>
      <%= consently_policy %>
    </main>

    <%= consently_banner %>
  </body>
</html>
